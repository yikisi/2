# 日本ダービー後
# トレーニング開始時に発生
separate_way:
  title: "길이 갈라지는 곳"
  lines:
    - "%YOU%이(가) 트레이닝실에서 다음 훈련 계획을 짜느라 바쁜 와중에 아르당이 문을 열고 들어왔다."
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - "「%CALLNAME%, 다녀왔습니다.」"
    - acc: 1
      content: "「어땠어? 치요노 오 양은 이제 괜찮은 거지?」"
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - "「네, %CALL_69%는 반드시 다시 경기장으로 돌아올 거예요.」"
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
