# @file メジロの呼び声 - 霧の探索イベント
# @author イーウィヤ
# @author 99

# 好事件
g_water:
  title: "달콤한 샘물"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU%과(와) %CHARA%은(는) 산책용 광장 같은 곳을 발견했다. 광장에는 비둘기들이 한가롭게 거닐고 있었고, 몇 마리는 작은 시설 위에 앉아 있었다."
        # 谨慎行动
        - if: d.action === 0
          content: "%YOU%과(와) %CHARA%은(는) 건물 뒤에서 조심스럽게 나왔다. 비둘기들이 날갯짓하며 잠시 날아오르자, 새들에게 둘러싸여 있던 작은 시설이 분수식 음수대라는 것을 알 수 있었다."
        # 普通行动
        - if: d.action === 1
          content: "%YOU%과(와) %CHARA%은(는) 빠른 걸음으로 다가갔다. 비둘기들이 날갯짓하며 잠시 날아오르자, 새들에게 둘러싸여 있던 작은 시설이 분수식 음수대라는 것을 알 수 있었다."
        # 急切行动
        - if: d.action === 2
          content: "%YOU%과(와) %CHARA%은(는) 서둘러 달려갔다. 비둘기들이 날갯짓하며 잠시 날아오르자, 새들에게 둘러싸여 있던 작은 시설이 분수식 음수대라는 것을 알 수 있었다."
        - "비둘기들에게 별다른 이상은 없어 보였다. 잠시 고민하다가 물을 떠서 천천히 마셨다."
    - if: d.first === 0
      lines:
        - "%YOU%과(와) %CHARA%은(는) 낯익은 음수대를 발견하고 물을 떠 마셨다."
    - "시원한 물이 메마른 목을 적시자 기운이 부쩍 돌아왔다. (체력+)"

g_lost_and_found:
  title: "분실물"
  lines:
    - if: d.first === 1
      lines:
        - "두 사람은 분실물 보관소를 발견했다."
        - "작고 귀여운 장식품, 손때 묻은 문고본, 살이 휜 접이식 우산…… 보관소에 있어도 이상할 것 없지만 딱히 쓸모는 없는 물건들이었다."
        - "그런데 어째서 포인트 카드 한 장의 뒷면, 소유자 서명란에 %YOU%의 이름이 적혀 있는 걸까."
        - "고민 끝에 %YOU%은(는) 쓸모없는 물건 더미 속에서 그 카드를 챙겼다. 어쩌면 원래부터 %YOU%의 물건이었을지도 모른다. (‘은총’+%REWARD%)"
    - if: d.first === 0
      lines:
        - "%YOU%은(는) 분실물 보관소에서 %YOU%의 이름이 적힌 포인트 카드를 발견했다. (‘은총’+%REWARD%)"

g_clothe:
  title: "몸단장"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU%과(와) %CHARA%은(는) 제법 깨끗한 공중화장실을 지나가다가 잠시 쉬기로 했다."
        - "볼일을 마친 %YOU%은(는) 세면대 수도꼭지를 틀어 차가운 물로 얼굴을 씻었다."
        - "서늘한 기운이 뒤통수까지 퍼지자 %YOU%은(는) 머리가 한결 맑아지는 것을 느꼈다."
        - "뒤따라 나온 %CHARA%의 얼굴에 남은 물방울도 닦아 주고, 두 사람은 다시 걷기 시작했다. (성욕-)"
    - if: d.first === 0
      lines:
        - "두 사람은 공중화장실에서 간단히 몸단장을 했다. (성욕-)"

g_chair:
  title: "나무 그늘의 벤치"
  lines:
    - if: d.first === 1
      lines:
        - "고층 건물이 늘어선 번화한 큰길에서 조금 벗어나, 근처 공원의 나무 그늘 아래 벤치에 앉았다."
        - "날씨는 맑고 숲속 공기는 상쾌했다. %YOU%과(와) %CHARA%은(는) 그 고요함을 만끽했다."
        - "벤치에 앉자 옆에 있는 담당이 미소를 지으며 %YOU%을(를) 바라본다. %YOU%은(는)……"
        - acc: 1
          content: "잠시 쉰다"
          lines:
            - "잠시 숨을 돌린 뒤, 옆에 있던 %CHARA%이(가) 일어나 자진해서 음료를 사러 가려 했다."
            - "%CHARA%이(가) 돌아올 때까지 %YOU%은(는) 등받이에 기대 눈을 감고 쉬었다. (%YOU% 성욕--)"
        - acc: 2
          content: "%CHARA%을(를) 혼자 있게 해 준다"
          lines:
            - "%YOU%은(는) 먼저 일어나 음료를 사러 갔다. 돌아오자 %CHARA%이(가) 몇 미터 앞에서부터 반갑게 맞이했다."
            - "잠시 쉰 뒤 빈 병을 쓰레기통에 버리고, 두 사람은 기분 좋게 다시 걷기 시작했다. (%CHARA% 성욕--)"
        - acc: 3
          content: "이야기한다"
          lines:
            - "%YOU%이(가) 옆에 있는 %SEX%에게 웃으며 말을 걸자, %CHARA%도 %YOU%에게 미소로 화답했다."
            - "웃고 떠들다 보니 두 사람은 어느새 다시 걷고 있었다. (성욕-)"
    - if: d.first === 0
      lines:
        - "두 사람은 나무 그늘의 벤치에 앉았다."
        - acc: 1
          content: "잠시 쉰다"
          lines:
            - "%CHARA%이(가) 혼자 움직이는 동안 %YOU%은(는) 눈을 감고 쉬었다. (%YOU% 성욕--)"
        - acc: 2
          content: "%CHARA%을(를) 혼자 있게 해 준다"
          lines:
            - "%YOU%은(는) 공원을 잠시 거닐며 %CHARA%을(를) 혼자 있게 해 주었다. (%CHARA% 성욕--)"
        - acc: 3
          content: "이야기한다"
          lines:
            - "두 사람은 잠시 이야기를 나누었다. (성욕-)"

g_bus:
  title: "대중교통"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU%과(와) %CHARA%은(는) 막 도착한 전철에 올랐다."
        - "다행히 이 칸에는 승객이 거의 없었다. 적당한 창가 자리를 골라 앉았다."
        - "전철이 천천히 움직이기 시작했다. %YOU%과(와) %CHARA%은(는) 손을 잡고 창가에 나란히 앉아, 바깥 풍경이 뒤로 흘러가는 모습을 바라보았다."
        - "이 평온함이 조금만 더 이어졌으면 좋겠다. 옆에 있는 담당의 미소 짓는 옆얼굴을 보며 %YOU%은(는) 문득 그렇게 생각했다."
        - "……안타깝게도 전철은 고작 한 정거장 만에 종점에 도착했다. (추가로 한 번 전진)"
    - if: d.first === 0
      lines:
        - "%YOU%과(와) %CHARA%은(는) 도착한 전철에 올라, 얼마 지나지 않아 종점에서 내렸다. (추가로 한 번 전진)"

g_lucky:
  title: "행운의 보상"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU%과(와) %CHARA%은(는) 편의점 근처에 잠시 머물기로 했다."
        - "그러자 %CHARA%이(가) 호기심에 이끌려 가게에 들어가더니, 처음 보는 작은 과자 한 봉지를 가져왔다."
        - acc: 1
          content: "봉지 안을 살펴본다"
          lines:
            - "%YOU%은(는) 담당에게 고맙다고 말한 뒤 조심스럽게 봉지를 뜯었다. 그러자 당첨 카드 한 장이 떨어졌다."
            - "뜻밖의 당첨이었다. 작은 경품이지만 두 사람의 기분은 확실히 좋아졌다. (‘은총’+%REWARD%)"
        - acc: 2
          content: "포장을 살펴본다"
          lines:
            - "포장에는 시제품이라고 적혀 있었다. 톡 쏘는 향 덕분에 %YOU%의 기운이 돌아왔다. (%YOU% 체력+)"
    - if: d.first === 0
      lines:
        - "두 사람은 편의점 근처에서 잠시 쉬었다. 가게에 들어갔던 담당이 처음 보는 작은 과자 한 봉지를 가져왔다."
        - acc: 1
          content: "봉지 안을 살펴본다"
          lines:
            - "봉지에서 당첨 카드가 떨어졌다…… (‘은총’+%REWARD%)"
        - acc: 2
          content: "포장을 살펴본다"
          lines:
            - "톡 쏘는 향 덕분에 %YOU%의 기운이 돌아왔다…… (%YOU% 체력+)"

# 普通事件
n_walk_through:
  title: "그저 지나가는 길"
  lines:
    - if: d.first === 1
      lines:
        - "이 좁은 골목을 지나기 전, %YOU%은(는) 조금 걱정이 되었다."
        - "하지만 아무 일도 일어나지 않았다. 갑작스러운 소나기도, 이상한 바람을 일으키는 보도블록도 없이 긴 골목을 무사히 지나왔다."
        - "다만 %YOU%은(는) 무의식중에 %CHARA%의 손을 잡았고, 출구를 지나고 나서도 놓을 생각을 하지 못했다."
    - if: d.first === 0
      lines:
        - "두 사람은 손을 잡고 좁은 골목을 지나왔다."

n_walk:
  title: "거리 산책"
  lines:
    - if: d.first === 1
      lines:
        - "두 사람은 밝고 정돈된 거리를 나란히 걸었다. 주변으로 행인과 여행객들이 삼삼오오 지나갔다."
        - "%YOU%과(와) %CHARA%은(는) 이번 외출의 여유를 즐기며, 조금씩 달라지는 분위기도 뒤로 흘려보냈다."
        - "이대로 갈까, 다른 길을 둘러볼까. 어느새 걸음이 빨라져 있었다."
    - if: d.first === 0
      lines:
        - "두 사람은 밝고 정돈된 거리를 나란히 걸었다."

n_shortcut:
  title: "숲속 지름길"
  lines:
    - "지나가던 숲 옆에 작은 길이 있었다. 다음 장소로 곧장 이어질 것 같았다."
    - "다만, 이 길은 꽤 외진 곳에 있다……"
    - acc: 1
      content: "조금 뛰면 도착하겠지 (체력-, 추가로 한 번 전진)"
      lines:
        - "두 사람은 가능한 한 가볍게 뛰며 다음 장소로 향했다."
    - acc: 2
      content: "천천히 걷자"
      lines:
        - "두 사람은 큰길로 가기로 했다."

n_street_food:
  title: "노점"
  lines:
    - "걷다가 노점 앞을 지나자 은은한 냄새가 풍겨 왔다."
    - "담당의 호기심 가득한 눈을 보고 %YOU%은(는)……"
    - acc: 1
      content: "조금 사 먹어 본다 (‘은총’-, 체력+)"
      lines:
        - "따뜻하고 맛있는 길거리 음식을 맛본 뒤, 두 사람은 여정을 이어 갔다."
    - acc: 2
      content: "다음에 먹자"

n_arcade:
  title: "경품 추첨 게임"
  lines:
    - if: d.first === 1
      lines:
        - "골목을 지나다가 연인들을 위한 경품 추첨 행사를 하는 가게를 발견했다."
        - "무거워 보이는 추첨 기계 앞에는 짝을 이룬 남녀들이 모여 있었다."
        - "그때 담당이 옷자락을 살며시 잡아당겼다……"
        - acc: 1
          content: "해 보자 (‘은총’+, 체력-)"
          lines:
            - "두 사람은 손을 맞잡고 손잡이를 힘껏 내렸다. 그러자 당첨 정보가 적힌 작은 공이 떨어졌다."
            - "손목은 아팠지만 수확은 있었다. 두 사람은 조금 들뜬 기분으로 그곳을 떠났다. (‘은총’+%REWARD%)"
        - acc: 2
          content: "그만두자"
          lines:
            - "%CHARA%은(는) 조금 실망한 기색을 보였지만, %YOU%의 의견을 받아들였다."
            - "두 사람은 그곳을 떠났다."
    - if: d.first === 0
      lines:
        - "골목을 지나다가 연인들을 위한 경품 추첨 행사를 하는 가게를 발견했다……"
        - acc: 1
          content: "함께 해 보자 (‘은총’+, 체력-)"
          lines:
            - "손목은 아팠지만 수확은 있었다. 두 사람은 기분 좋게 그곳을 떠났다. (‘은총’+%REWARD%)"
        - acc: 2
          content: "그만두자"

n_promotion:
  title: "가게 홍보"
  lines:
    - if: d.first === 1
      lines:
        - "길모퉁이를 지나다가 눈에 잘 띄지 않는 옷가게가 시선을 끌었다."
        - "점원은 %CHARA%에게 보수를 주는 시착을 열심히 권했다. 하지만 그 옷은 누가 봐도 선정적이었다."
        - "두 사람은 서로 얼굴을 바라보며……"
        - acc: 1
          content: "해 볼까? (‘은총’+, %YOU% 성욕+, %CHARA% 성욕+)"
          lines:
            - "그 옷을 입은 %CHARA%이(가) 부끄러워하며 %YOU%에게 몸을 보여 주자, %YOU%의 숨도 조금 거칠어졌다."
            - "나중에 가게에서는 기념으로 시착 사진 한 장을 두 사람에게 건넸다…… (‘은총’+%REWARD%)"
        - acc: 2
          content: "그만두자"
          lines:
            - "고민 끝에 두 사람은 사양했다."
            - "옷가게를 떠났다."
    - if: d.first === 0
      lines:
        - "길모퉁이를 지나다가 보수를 주는 시착 행사를 하는 옷가게가 시선을 끌었다……"
        - acc: 1
          content: "해 볼까? (‘은총’+, %YOU% 성욕+, %CHARA% 성욕+)"
          lines:
            - "옷이 너무 선정적이어서 두 사람의 숨도 거칠어졌다…… (‘은총’+%REWARD%)"
        - acc: 2
          content: "그만두자"

# 坏事件
b_pet_anal:
  title: "엉덩이 잡기"
  lines:
    # [正常]-[不安]
    - "두 사람은 아무도 없는 작은 노점 앞을 지나갔다."
    - "%YOU%이(가) 노점 안에서 쓸 만한 물건을 찾고 있는데, 갑자기 누군가 엉덩이를 움켜쥐었다."
    - "%YOU%이(가) 돌아보자 %CHARA%은(는) 아무 일도 없었다는 듯 노점 옆의 무언가를 보고 있었다."
    - acc: 1
      content: "되갚아 준다"
      lines:
        - "%YOU%은(는) 보복으로 %SEX%의 엉덩이를 움켜쥐었다."
        - "두 사람은 서로 웃으며 노점을 떠났다. (%YOU% 성욕++, %CHARA% 성욕+)"
    - acc: 2
      content: "없었던 일로 한다"
      lines:
        - "%YOU%은(는) 결국 없었던 일로 하기로 했다."
        - "%YOU%과(와) 웃음을 참는 %CHARA%은(는) 차례로 노점을 떠났다. (%CHARA% 성욕++)"

b_hug:
  title: "갑작스러운 포옹"
  lines:
    # [正常]-[不安]
    - "이 좁고 어두운 골목을 지나기 전, %YOU%은(는) 뜻밖의 위험이 있지는 않을까 조금 걱정했다."
    - "하지만 바람대로 되지는 않았다. 갑자기 튀어 오른 보도블록에 %CHARA%의 발이 걸려, %YOU% 쪽으로 넘어졌다."
    - 정신을 차려 보니, 품 안의 %TEEN%은 부드럽고 달콤했다. 수줍음에 물든 얼굴이 바로 눈앞에 있다……
    - acc: 1
      content: "몸을 쓰다듬는다"
      lines:
        - %YOU%의 손가락이 자연스럽게 담당자의 가느다란 등을 스치자 팔 안에 안긴 %TEEN%는 부끄러움에 작은 신음을 내뱉었다.
        - 두 사람은 오랫동안 서로를 껴안은 뒤 떨어졌지만 %YOU%은(는) 아직 부족하다는 생각이 들었다……（%YOU% 성욕++, %CHARA% 성욕+）
    - acc: 2
      content: "바로 일으켜 세운다"
      lines:
        - "%YOU%은(는) 곧바로 %CHARA%을(를) 일으켜 세웠다. %CHARA%은(는) 수줍게 웃으며 무언가 말하려다가 고개만 끄덕였다."
