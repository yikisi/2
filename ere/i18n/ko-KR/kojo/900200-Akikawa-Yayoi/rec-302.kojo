# @file 秋川やよい - 募集
# @author 黑奴队长（临时）
# @author Claude (翻訳)

recruit:
  - color: %COLOR%
    content:
      - fontWeight: bold
        content: %CHARA%
      - "「경악!」"
  - color: %COLOR%
    content:
      - fontWeight: bold
        content: %CHARA%
      - "「당황! 어, 어, 어쩌면 좋단 말인가!」"
  - "「장군! 이제 도망갈 곳은 없군. 나와 함께 가세!」"
  - color: %COLOR%
    content:
      - fontWeight: bold
        content: %CHARA%
      - "「아바바바바바……」"
  - content:
      - "축하! "
      - color: '#ffad7e'
        content: %CHARA%
      - isBr: 1
      - "가 팀에 합류했다!"
