# @file 乙名史悦子 - 募集
# @author 黑奴队长（临时）
# @author Claude (翻訳)

# @author 黑奴队长（临时）
rec_0:
  title: "취재 시작"
  lines:
    - "%TRACK%를 떠나던 %YOU%는 기자처럼 보이는 %PHY%와 우연히 마주쳤다."
    - if: era.get('flag:初见URA颁奖') > 0
      content: "%YOU%는 매년 시상식에 나오는 %CHARA%라는 것을 알아보았다."
    - "그녀는 자신을 기자 %CHARA_ACTUAL%라고 소개했다."
    - "가볍게 인사를 나눈 뒤, 앞으로 %YOU%의 팀이 보여 줄 활약을 기대하겠다고 말했다."

# @author 黑奴队长（临时）
rec_1:
  title: "전속 기자"
  lines:
    - "%YOU%는 학원 정문에서 우연히 %CHARA%를 만났다."
    - "%CHARA%가 고개를 숙여 인사하자 %YOU%는 그쪽으로 다가갔다."
    - "%CHARA%는 %YOU%의 활약을 보고 이제 %YOU% 팀의 전속 기자를 맡게 되었다고 말했다."
    - "물론 취재를 더 허락해 준다면 좋은 소식은 널리 알리고, 나쁜 소문은 최대한 잠재워 주겠다고도 했다."
    - "그렇게 말하는 %CHARA%의 얼굴에 환한 미소가 번졌다."
    - "（이제 손님 응접실에서 만날 수 있을 것이다）"

rec_2:
  - "%CHARA%는 미소 지으며 앞으로 좋은 소문은 널리 알리고, 악평의 영향은 줄여 주겠다고 약속했다."
  - if: era.get('love:303') >= 75
    content: "그 대신에……그녀는 %YOU%의 손을 살며시 어루만지며 윙크했다."
  - if: era.get('love:303') < 75
    lines:
      - "그 대신에……트레이닝에 지장이 없는 범위에서 %YOU%의 팀을 밀착 취재하게 해 달라고 요청했다."
      - if: era.get('love:303') >= 50
        content: "악수로 이야기를 마무리한 뒤, %CHARA%는 자기 손바닥을 천천히 문지르며 무언가 생각에 잠긴 듯했다."
      - if: era.get('love:303') < 50
        content: "악수로 이야기를 마무리한 뒤, %CHARA%는 계획대로라는 듯 장난스러운 미소를 지었다."
