    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-require-sort": "^1.3.0",
    "eslint-plugin-sort-requires-by-path": "^1.0.2",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "kojo-loader": "git+https://gitgud.io/umaera/engine/kojo-loader.git",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "webpack": "^5.100.1",
    "webpack-cli": "^5.1.4"
  },
