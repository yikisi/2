{
 
  "eslint.options": {
      "extensions": [".js", ".vue"]
  },
  "eslint.validate": [
      "javascript",
      "javascriptreact",
      "vue-html",
      {
          "language": "vue",
          "autoFix": true
      },
      {
          "language": "html",
          "autoFix": true
      }
  ],
  "eslint.run": "onSave",
  "eslint.autoFixOnSave": true,
  
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
}
}