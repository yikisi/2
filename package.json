    "ere-webpack-plugin": "git+https://gitgud.io/umaera/engine/ere-webpack-plugin.git",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-require-sort": "^1.3.0",
    "eslint-plugin-sort-requires-by-path": "^1.0.2",
    "fs-extra": "^11.4.1",
    "husky": "^9.1.7",
    "kojo-loader": "git+https://gitgud.io/umaera/engine/kojo-loader.git",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
